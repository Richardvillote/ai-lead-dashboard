# ── Cloudflare Pages Environment Variables Reference ─────────────────────────
# Copy these into: Cloudflare Dashboard → Pages → your-project → Settings → Environment variables
# (Set both Production and Preview environments)

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Used by Prisma for migrations (not needed at runtime — Supabase client handles queries)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Dashboard Auth ────────────────────────────────────────────────────────────
DASHBOARD_PASSWORD="your-secure-password"
DASHBOARD_SECRET="your-random-secret-at-least-32-chars"

# ── Supabase ──────────────────────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# From: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Must be a verified domain/email in Resend
EMAIL_FROM="noreply@yourdomain.com"
# Where new lead notifications are sent
EMAIL_TO="you@yourdomain.com"

# ── Lead Search Providers ─────────────────────────────────────────────────────
# OPTION 1: Google Places API (best results, requires billing)
GOOGLE_PLACES_API_KEY="AIza..."
# OPTION 2: Yelp Fusion API (free 500/day)
YELP_API_KEY="your_yelp_api_key"
# OPTION 3: OpenStreetMap — no key needed, automatic fallback

# ── Twilio (Optional — for click-to-call feature) ────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
ADMIN_PHONE_NUMBER="+1xxxxxxxxxx"

# ── Public (visible in browser) ───────────────────────────────────────────────
NEXT_PUBLIC_BUSINESS_NAME="Your Business Name"
NEXT_PUBLIC_BUSINESS_TAGLINE="Professional Services You Can Trust"
NEXT_PUBLIC_APP_URL="https://ai-lead-dashboard.pages.dev"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
